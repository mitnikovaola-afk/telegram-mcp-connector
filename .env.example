# Copy to .env (never commit .env). Every value below is read only by this process.

# --- Telegram: https://my.telegram.org → API development tools ---
TG_API_ID=
TG_API_HASH=

# --- Team bot in group chats (beyond the test task): @BotFather → /newbot → token ---
# Optional locally (the MCP server and `tg-connector sync` work without it);
# required for the hosted worker (`tg-connector bot --sync`).
TG_BOT_TOKEN=

# --- Gemini: https://aistudio.google.com → Get API key (free tier: do NOT link billing) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# How much Gemini 3.x "thinks" before answering: empty = model default (best quality) | low | medium | high
GEMINI_THINKING_LEVEL=

# --- Notion: https://www.notion.so/profile/integrations → New integration → Internal Integration Secret ---
NOTION_TOKEN=
# Link (or id) of the page where the connector creates its databases (days, tasks, projects)
# and the «Службове» (service) page that holds the project log.
# The page must be shared with the integration: ••• → Connections → <your integration>.
NOTION_PARENT_PAGE_ID=

# --- Behaviour (defaults are fine) ---
TIMEZONE=Europe/Kyiv
# Background sync while the MCP server runs; 0 disables it (use cron / `tg-connector sync` instead).
SYNC_INTERVAL_MINUTES=30
# First sync of a newly tracked chat only reads this many days back.
BACKFILL_DAYS=7
# Re-read the last N hours of already synced messages to catch edits (0 = off).
EDIT_LOOKBACK_HOURS=24
# Summarize the current day while it is still going (updated in place), or only finished days.
# Gemini free tier allows ~20 requests/day per model: with many active chats prefer false (1 call per chat-day).
SUMMARIZE_TODAY=true
# "auto" = language of the chat; or e.g. "Ukrainian", "English".
SUMMARY_LANGUAGE=auto
# Project knowledge base in Notion (beyond the test task): project passport for newcomers + project log, updated daily.
PROJECTS_ENABLED=true
# per_chat = every tracked group gets its own project | single = all groups feed one project named PROJECT_NAME
PROJECTS_MODE=per_chat
PROJECT_NAME=Мій проєкт
# The first run after this local hour updates the passports and logs (one LLM call per active project per day).
PROJECT_BRIEF_HOUR=7
# Safety switches for the send tool.
READ_ONLY=false
SEND_ONLY_TRACKED=true

# --- Hosted worker (Railway); leave empty locally ---
# Telegram session for the cloud as a (sealed) variable: create it with `tg-connector login --cloud`.
TG_SESSION=
# Wait for the uploaded database (`tg-connector snapshot` + `railway volume files upload`) instead of starting from zero.
WAIT_FOR_STATE=false
# Keep raw message texts only N days after their day is final and summarized (0 = keep forever).
RAW_RETENTION_DAYS=0

# --- Advanced (defaults are fine; uncomment to change) ---
# Folder for the database, Telegram sessions and logs. A relative path starts at the project folder.
# The Docker image (hosted worker) sets DATA_DIR=/data, the volume.
# DATA_DIR=data
# Max characters of chat text in one LLM request; a longer day is split into parts that are then merged.
# MAX_CHARS_PER_LLM_CALL=60000
# A day is given up after this many failed summary attempts. Temporary errors (429/5xx, timeouts)
# do not count; a new message in that day resets the counter.
# MAX_LLM_ATTEMPTS=5
# Telegram messages stored per transaction; the sync cursor moves forward after each batch.
# SYNC_BATCH_SIZE=200
# Run lock lifetime in seconds. A running sync keeps renewing it; a lock left by a crashed run
# expires after this time, and the next run takes over.
# LOCK_TTL_SECONDS=900
